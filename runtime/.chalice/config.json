{
  "version": "2.0",
  "app_name": "chatgpt-telegram-bot",
  "environment_variables": {
    "TIKTOKEN_CACHE_DIR": "/tmp"
  },
  "stages": {
    "dev": {
      "api_gateway_stage": "api",
      "autogen_policy": true,
      "environment_variables": {
        "OPENAI_API_KEY": "",
        "TELEGRAM_TOKEN": ""
      },
      "lambda_functions": {
        "api_handler": {
          "lambda_memory_size": 128
        },
        "message_handler": {
          "lambda_memory_size": 256
        }
      }
    }
  }
}
